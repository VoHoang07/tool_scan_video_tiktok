# ==============================================================================
# CẤU HÌNH API KEY DỊCH THUẬT (LLM API)
# Hệ thống tự động ưu tiên theo thứ tự: LLM_PROVIDER được chỉ định -> Gemini -> DeepSeek -> OpenAI -> Fallback Translator
# ==============================================================================

# Chọn provider: auto | gemini | deepseek | openai
LLM_PROVIDER=auto

# 1. Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 2. DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 3. OpenAI API (hoặc bất kỳ endpoint tương thích OpenAI nào)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# CẤU HÌNH PIPELINE (WHISPER, TTS, COMPOSER)
# ==============================================================================

# Model faster-whisper: base | small | medium
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Giọng đọc Edge-TTS: vi-VN-HoaiMyNeural (Nữ) | vi-VN-NamMinhNeural (Nam)
TTS_VOICE=vi-VN-HoaiMyNeural

# Mức âm lượng âm thanh gốc khi lồng tiếng (0.0 = tắt hẳn, 0.07 = audio ducking giữ nhạc nền nhẹ, triệt tiêu tiếng gốc)
ORIGINAL_AUDIO_VOLUME=0.07

# Cookie tùy chọn cho Douyin/TikTok (nếu muốn truyền file cookies.txt)
COOKIES_FILE=
